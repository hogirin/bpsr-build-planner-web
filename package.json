{
  "name": "bpsr-build-planner-web",
  "private": true,
  "version": "0.11.3",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.web.ts",
    "build": "tsc -b && vite build --config vite.config.web.ts",
    "preview": "vite preview --config vite.config.web.ts",
    "format": "prettier --write .",
